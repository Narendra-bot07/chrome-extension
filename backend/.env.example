DATABASE_URL=postgresql://postgres:change-me@localhost:5433/postgres

# --- Supabase Storage (original-resumes / generated-resumes buckets) ---
# Required in production. Without these, get_storage_service() falls back to
# local disk (backend/local_uploads/), which does NOT survive a redeploy or
# restart on an ephemeral host like Render.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=30
SESSION_INACTIVITY_MINUTES=30
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_JD_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
# Latency budget for the single uncached JD extraction call. Unlike the
# global timeout, this path falls back to deterministic page evidence.
JD_EXTRACTION_LLM_TIMEOUT_SECONDS=40
JD_EXTRACTION_AI_QUEUE_TIMEOUT_SECONDS=3

# Prevent one crashed Chromium page or a stale render backlog from occupying
# the PDF endpoint for many minutes.
PDF_RENDER_NAVIGATION_TIMEOUT_MS=8000
PDF_RENDER_READY_TIMEOUT_SECONDS=30
PDF_RENDER_FONTS_TIMEOUT_MS=5000
PDF_RENDER_QUEUE_TIMEOUT_SECONDS=75
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_ENABLE_THINKING=false
DEEPSEEK_MAX_CONCURRENT_REQUESTS=8
LLM_PROVIDER=deepseek

# --- Observability Settings ---
OBSERVABILITY_ENABLED=true
APP_ENV=local
APP_RELEASE=
SERVICE_NAME=tailr4u-api

# Local-testing-only convenience: lets the paid-plan checkout flow "activate"
# a plan without a real Stripe/Razorpay payment, for exercising paid-tier UI
# without live payment credentials. Leave unset/false everywhere except your
# own local machine -- never set this in a deployed environment.
ALLOW_MOCK_BILLING_ACTIVATION=false

# Sentry
SENTRY_BACKEND_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_EXTENSION_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0

# Metrics (Prometheus)
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_BEARER_TOKEN=your-bearer-token-for-grafana-scraper-here

# Grafana Cloud hosted Prometheus (Mimir) -- the app pushes its own metrics
# registry here on an interval via remote_write (Render has no sidecar to
# pull-scrape /metrics). Get these 3 values from Grafana Cloud ->
# My Account -> your stack -> Prometheus card -> "Send metrics" / Details.
# Blank URL = disabled. See docs/OBSERVABILITY.md.
GRAFANA_CLOUD_PROM_REMOTE_WRITE_URL=
GRAFANA_CLOUD_PROM_USERNAME=
GRAFANA_CLOUD_PROM_API_KEY=
GRAFANA_CLOUD_PROM_PUSH_INTERVAL_SECONDS=30

# OpenTelemetry Tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=tailr4u-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- LLM Redis Caching Layer ---
LLM_CACHE_ENABLED=true
LLM_CACHE_NAMESPACE=tailr4u
LLM_CACHE_SCHEMA_VERSION=v1
LLM_CACHE_TTL_JD_SECONDS=604800
LLM_CACHE_TTL_RECOVERY_SECONDS=604800
LLM_CACHE_TTL_TAILORING_SECONDS=86400
LLM_CACHE_TTL_SUMMARY_SECONDS=86400
LLM_CACHE_TTL_COVER_LETTER_SECONDS=86400
LLM_CACHE_LOCK_TTL_SECONDS=120
# Was 15 -- shorter than real JD-extraction/tailoring calls actually take
# (28-90s in production), so a waiter always gave up and made its own
# redundant LLM call anyway instead of ever benefiting from the lock.
LLM_CACHE_LOCK_WAIT_SECONDS=100.0
