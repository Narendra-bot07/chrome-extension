# ── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=Tailr4U
VITE_APP_ENV=production
VITE_APP_RELEASE=tailr4u-frontend@1.0.0   # set by CI from git tag

# ── Backend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://your-api.onrender.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_ENABLE_GOOGLE_PROFILE_ENRICHMENT=true

# ── Supabase (public browser-safe values only) ────────────────────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Sentry Error Monitoring ───────────────────────────────────────────────────
# Get DSN from: sentry.io → New Project → React → copy DSN
# The DSN is safe to expose in frontend bundles (it is public by design)
VITE_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
VITE_SENTRY_ENABLED=true
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05   # 5% of transactions traced

# ── PostHog Analytics ─────────────────────────────────────────────────────────
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_POSTHOG_ENABLED=true

# ── Feature flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_MONITORING=true

# ── SEO / Search & Analytics (index.html reads these at build time) ───────────
# Google Search Console: Settings → Ownership verification → HTML tag → copy
# just the `content` value.
VITE_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GOOGLE_ANALYTICS_ID=
# Microsoft Clarity project ID (clarity.microsoft.com → Setup → project ID)
VITE_CLARITY_PROJECT_ID=
